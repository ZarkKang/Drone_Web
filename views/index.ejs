        function toggleParam(key) {
            droneConfig[key] = !droneConfig[key];
            if (key === 'highFPSMode' || key === 'autoFocusLock') {
                startStream(localStorage.getItem('defaultCameraId'));
            }
        }

        function alterResolution(val) {
            droneConfig.resolution = val;
            startStream(localStorage.getItem('defaultCameraId'));
        }

        // --- 7. 异步非重载视图拼接器（对接数据库等） ---
        async function fetchAndInjectPartialView(url) {
            try {
                const res = await fetch(url, { headers: { 'x-partial-content': 'true' } });
                const rawHtml = await res.text();
                
                const parser = new DOMParser();
                const parsedDoc = parser.parseFromString(rawHtml, 'text/html');
                const targetDOM = parsedDoc.querySelector('.db-page-wrapper');
                
                if (targetDOM) {
                    document.getElementById('app-content').innerHTML = targetDOM.outerHTML;
                    
                    // 动态注入并执行外部子页面的独立数据刷新函数
                    const inlineScripts = parsedDoc.querySelectorAll('script');
                    inlineScripts.forEach(script => {
                        if(script.innerText.includes('loadRecords')) { eval(script.innerText); }
                    });
                    
                    // 启动属于该单页内部的局部数据拉取时钟
                    if (typeof loadRecords === 'function') {
                        loadRecords();
                        partialRefreshInterval = setInterval(loadRecords, 4000);
                    }
                }
            } catch(e) { console.error("SPA拼装异常:", e); }
        }

        function rebindDashboardDOM() {
            // 返回主控台时重组原始底层设备数据映射
            navigator.mediaDevices.enumerateDevices().then(devices => {
                const videoDevices = devices.filter(d => d.kind === 'videoinput');
                const selectEl = document.getElementById('videoSource');
                if (selectEl) {
                    selectEl.innerHTML = videoDevices.map((d, i) => 
                        `<option value="${d.deviceId}">${d.label || '相机 ' + (i+1)}</option>`
                    ).join('');
                    selectEl.value = localStorage.getItem('defaultCameraId') || "";
                    selectEl.onchange = () => startStream(selectEl.value);
                }
            });
        }

        // --- 8. 原有条码打印生成器核心兼容组件移植 ---
        function openQRGenerator() { document.getElementById('qrGeneratorModal').style.display = 'flex'; }
        function closeQRGenerator() { document.getElementById('qrGeneratorModal').style.display = 'none'; }
        function addCustomTagRow() {
            const container = document.getElementById('customTagsContainer');
            const row = document.createElement('div');
            row.className = 'tag-row';
            row.innerHTML = `<input type="text" placeholder="键" class="tag-key modal-input" style="flex:1">
                             <input type="text" placeholder="值" class="tag-val modal-input" style="flex:1">
                             <button onclick="this.parentElement.remove()" style="color:red; background:none; border:none; cursor:pointer">×</button>`;
            container.appendChild(row);
        }
        function doGenerate() {
            const id = document.getElementById('qrInputID').value.trim();
            const qty = document.getElementById('qrInputQty').value;
            if (!id) return alert("请输入编号");
            const attr = {};
            document.querySelectorAll('.tag-row').forEach(row => {
                const k = row.querySelector('.tag-key').value.trim();
                const v = row.querySelector('.tag-val').value.trim();
                if(k) attr[k] = v;
            });
            const displayArea = document.getElementById('qrcode-display');
            displayArea.innerHTML = "";
            const dataStr = JSON.stringify({ id, qty: parseInt(qty), attr, t: Date.now() });
            const finalData = unescape(encodeURIComponent(dataStr));
            new QRCode(displayArea, { text: finalData, width: 160, height: 160, correctLevel: QRCode.CorrectLevel.H });
            document.getElementById('btnDownload').style.display = 'block';
        }
        function downloadQR() {
            const canvas = document.querySelector('#qrcode-display canvas');
            const p = document.createElement('canvas'); const ctx = p.getContext('2d');
            p.width = 300; p.height = 350; ctx.fillStyle = "white"; ctx.fillRect(0,0,300,350);
            ctx.drawImage(canvas, 70, 30, 160, 160);
            ctx.fillStyle = "black"; ctx.font = "bold 16px Arial"; ctx.textAlign = "center";
            ctx.fillText("ID: " + document.getElementById('qrInputID').value, 150, 230);
            const a = document.createElement('a'); a.download = "label.png"; a.href = p.toDataURL(); a.click();
        }
    </script>
