<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header class="navbar">
        <div class="logo"><i class="fas fa-microchip"></i> DRONE RECON <span>V2</span></div>
        <nav>
            <a href="/"><i class="fas fa-th-large"></i> 仪表盘</a>
            <a href="/database" class="active"><i class="fas fa-database"></i> 数据中心</a>
        </nav>
    </header>

    <div class="db-page-wrapper">
         <div class="db-header">
            <div class="title-section">
                <h2>数据库存证</h2>
                <p style="color: #64748b; margin-top: 5px;">高动态巡检历史记录底层固化存证中心</p>
            </div>
            
            <div class="control-section">
                 <div class="stat-badge">
                    <span style="color: #64748b; font-size: 0.8rem;">总计记录</span>
                    <span id="total-count" class="count">0</span>
                </div>
                <button onclick="window.loadRecords()" class="stat-badge" style="cursor:pointer; background: rgba(56, 189, 248, 0.1); border-color: #38bdf8;">
                    <i class="fas fa-rotate" id="refresh-icon"></i>
                </button>
            </div>
        </div>

        <div class="db-card">
            <table>
                 <thead>
                    <tr>
                        <th><i class="far fa-clock"></i> 扫描时间</th>
                        <th><i class="fas fa-barcode"></i> 货物标识符</th>
                        <th>现场环境图</th>
                        <th>二维码存证</th>
                        <th style="text-align: center;">数据管理</th>
                    </tr>
                </thead>
                <tbody id="db-table-body">
                    </tbody>
            </table>
        </div>

        <div id="modal" class="modal" onclick="window.closeModal()">
            <img id="modalImg" style="max-width:90%; max-height:85%; border-radius:15px; box-shadow:0 0 50px rgba(0,0,0,0.5); border: 2px solid rgba(255,255,255,0.1);">
            <p style="position:absolute; bottom:30px; color:#94a3b8; background:rgba(15,23,42,0.8); padding:8px 20px; border-radius:30px; font-size:0.85rem; border:1px solid rgba(255,255,255,0.05);">点击任意位置退出大图预览</p>
        </div>
    </div>

    <script>
        // 利用立即执行函数域限制局部变量，同时显式对外挂载系统句柄
        (function() {
            let lastId = null;

            // 1. 异步核心渲染引擎
            window.loadRecords = async function() {
                const icon = document.getElementById('refresh-icon');
                if (icon) icon.classList.add('fa-spin');

                try {
                    const response = await fetch('/api/records');
                    if (!response.ok) throw new Error("API通信链路故障");
                    const records = await response.json();
                    
                    const tableBody = document.getElementById('db-table-body');
                    const totalCountEl = document.getElementById('total-count');
                    
                    if (totalCountEl) totalCountEl.innerText = records.length;
                    if (!tableBody) return;

                    // 去抖校验：如果云端最新 ID 与当前首行一致，中断重绘保护系统能效
                    if (records.length > 0 && records[0]._id === lastId) {
                        return;
                    }
                    lastId = records.length > 0 ? records[0]._id : null;
                    tableBody.innerHTML = '';
                 
                    records.forEach((item, index) => {
                        const row = document.createElement('tr');
                        if (index === 0 && lastId !== null) row.classList.add('new-row-flash');
                        row.innerHTML = `
                            <td style="color: #94a3b8; font-size: 0.85rem;">
                                ${new Date(item.timestamp).toLocaleString()}
                            </td>
                            <td>
                                <span class="id-pill">${item.cargoId}</span>
                            </td>
                            <td>
                                 <div class="img-wrapper" onclick="window.showModal('${item.envImage}')">
                                    <img src="${item.envImage}" alt="物理全景图">
                                </div>
                            </td>
                            <td>
                                <div class="img-wrapper" onclick="window.showModal('${item.qrImage}')">
                                    <img src="${item.qrImage}" alt="条码局部切图">
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <button class="btn-del" onclick="window.deleteRecord('${item._id}')" title="从底层云端永久擦除此记录">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        `;
                        tableBody.appendChild(row);
                    });
                } catch (err) {
                    console.error("[Database Layer] 渲染中断:", err);
                } finally {
                    if (icon) setTimeout(() => icon.classList.remove('fa-spin'), 500);
                }
            };

            // 2. 物理数据抹除安全执行器
            window.deleteRecord = async function(id) {
                if (!id) return;
                if (!confirm('🚨 警告：您正准备从云端数据库中永久注销此货物扫描实体，此操作不可逆！确定继续吗？')) return;
                
                try {
                    const res = await fetch(`/api/delete-record/${id}`, { 
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    
                    if (!res.ok) throw new Error("后端服务未予正常回应");
                    const data = await res.json();
                    
                    if (data.success) {
                        // 核心修复：抹除历史缓存去抖器，强制使重加载功能生效重塑 DOM 树
                        lastId = null; 
                        await window.loadRecords(); 
                    } else {
                        alert(`删除未成功 执行响应: ${data.message}`);
                    }
                } catch (err) {
                    console.error("[Database Operation] 删除故障:", err);
                    alert("底层网络或网关阻塞，无法下发注销指令。");
                }
            };

            // 3. 全景灯箱交互模块
            window.showModal = function(src) {
                const modal = document.getElementById('modal');
                const modalImg = document.getElementById('modalImg');
                if (modal && modalImg) {
                    modal.style.display = 'flex';
                    modalImg.src = src;
                }
            };

            window.closeModal = function() {
                const modal = document.getElementById('modal');
                if (modal) modal.style.display = 'none';
            };

            // 初始化装载执行
            window.loadRecords();
        })();
    </script>
</body>
</html>